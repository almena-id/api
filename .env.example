# Almena Registry API configuration. `task init` copies this file to .env,
# which the API (pydantic-settings), Docker Compose and Task all read.

# development | production | test. `production` hides /docs and /openapi.json.
REGISTRY_ENVIRONMENT=development
REGISTRY_LOG_LEVEL=INFO
# json (one object per line, what the container always uses) or text, for a
# terminal. Left unset, task dev writes text; uncomment it to see its JSON.
# REGISTRY_LOG_FORMAT=json

# Port published on the host by Docker Compose (the API listens on 8000 inside).
REGISTRY_API_PORT=8000

# Public origin of the API, advertised as the server in /openapi.json and /docs.
REGISTRY_PUBLIC_URL=https://api.almena.id

# The identity domain: identities' did:web DIDs are made from it
# (did:web:almena.id:ids:…) and resolve there. It must proxy /ids/ and
# /.well-known/ to this API. For a local-only setup: http://localhost:8000
REGISTRY_DID_URL=https://almena.id

# Origins allowed by CORS, as a JSON list: the registry portal. Add
# "http://localhost:3000" to work with its `task dev` in ../registry.
REGISTRY_CORS_ORIGINS=["https://registry.almena.id"]

# Directory with the origin's did-configuration.json, served at /.well-known/.
# Empty serves none. (/.well-known/did.json is the root tenant's.) Under `task up`, ./well-known is mounted.
REGISTRY_WELL_KNOWN_DIR=./well-known
# Public resolvers asked for a domain's TXT proof, as a JSON list of IPs.
REGISTRY_DNS_RESOLVERS=["1.1.1.1","8.8.8.8"]

# PostgreSQL. Compose creates the database with these credentials on the first
# start; `task dev` reaches it on 127.0.0.1:REGISTRY_DB_PORT.
REGISTRY_DB_HOST=localhost
REGISTRY_DB_PORT=5432
REGISTRY_DB_NAME=registry
REGISTRY_DB_USER=registry
# `task init` fills it with a random one.
REGISTRY_DB_PASSWORD=
REGISTRY_DB_POOL_SIZE=5
# Log every SQL statement.
REGISTRY_DB_ECHO=false

# A portal sign-in ends this many hours after it started, used or not,
# or earlier once no request has used it for this many minutes.
REGISTRY_SESSION_TTL_HOURS=12
REGISTRY_SESSION_IDLE_MINUTES=30
# Emailed sign-in codes: minutes before one expires, wrong guesses allowed.
REGISTRY_LOGIN_CODE_TTL_MINUTES=10
REGISTRY_LOGIN_CODE_MAX_ATTEMPTS=5

# Outgoing mail. By default Mailpit (`task mail`, or the `mailpit` service in
# `task up`): nothing is delivered, every email shows at http://localhost:8025.
REGISTRY_SMTP_HOST=localhost
REGISTRY_SMTP_PORT=1025
REGISTRY_SMTP_USERNAME=
REGISTRY_SMTP_PASSWORD=
REGISTRY_SMTP_STARTTLS=false
REGISTRY_MAIL_FROM=Almena Registry <no-reply@almena.id>
# The SMTP host as the API container reaches it under `task up`.
REGISTRY_SMTP_DOCKER_HOST=mailpit
REGISTRY_MAILPIT_UI_PORT=8025

# OpenObserve, where the logs are indexed (`task openobserve`, or the
# `openobserve` service in `task up`): UI at http://localhost:REGISTRY_OPENOBSERVE_PORT,
# signing in with the admin below. The password needs a lowercase and an
# uppercase letter, a digit and a symbol; `task init` fills it with a random one.
REGISTRY_OPENOBSERVE_PORT=5080
REGISTRY_OPENOBSERVE_ADMIN=admin@almena.id
REGISTRY_OPENOBSERVE_PASSWORD=
# Days before log entries are deleted.
REGISTRY_OPENOBSERVE_RETENTION_DAYS=30

# RabbitMQ, the tenants' message broker (`task rabbitmq`, or the `rabbitmq`
# service in `task up`). Their applications connect over AMQP on
# REGISTRY_RABBITMQ_PORT (published on every interface); the management UI is
# at http://localhost:REGISTRY_RABBITMQ_UI_PORT, signing in with the admin
# below, the platform's own account. Tenants' queues live in REGISTRY_RABBITMQ_VHOST.
# `task init` fills the password with a random one.
REGISTRY_RABBITMQ_PORT=5672
REGISTRY_RABBITMQ_UI_PORT=15672
REGISTRY_RABBITMQ_ADMIN=almena
REGISTRY_RABBITMQ_PASSWORD=
REGISTRY_RABBITMQ_VHOST=almena
# The management HTTP API the API manages queues and users through, and where
# tenants' applications connect (shown to them with their queue).
REGISTRY_RABBITMQ_API_URL=http://localhost:15672
REGISTRY_RABBITMQ_AMQP_URL=amqp://localhost:5672
# The management API as the API container reaches it under `task up`.
REGISTRY_RABBITMQ_DOCKER_API_URL=http://rabbitmq:15672

# The vault where the keys of the issuers, verifiers and mediators are kept.
# Only `openbao` so far; another service (Azure Key Vault…) is another provider.
REGISTRY_VAULT_PROVIDER=openbao

# OpenBao (`task openbao`, or the `openbao` service in `task up`). Its API and
# UI stay on loopback, at http://localhost:REGISTRY_OPENBAO_PORT/ui. The first
# run initializes it and keeps its unseal key and root token in
# .openbao-keys.json; every run provisions the KV v2 mount below and the
# AppRole the API signs in with. `task init` fills the secret id with a random one.
REGISTRY_OPENBAO_PORT=8200
# Where task dev reaches it (keep the port in step with the one above).
REGISTRY_OPENBAO_ADDR=http://localhost:8200
REGISTRY_OPENBAO_MOUNT=almena
REGISTRY_OPENBAO_ROLE_ID=registry-api
REGISTRY_OPENBAO_SECRET_ID=
# Where the API container reaches it under `task up`.
REGISTRY_OPENBAO_DOCKER_ADDR=http://openbao:8200

# The portal's public origin. Providers send the browser back to
# {REGISTRY_PORTAL_URL}/auth/{provider}/callback: register that URI with each.
# The catalog, where holders apply for credentials: the wallet answers it then.
REGISTRY_CATALOG_URL=https://catalog.almena.id
REGISTRY_PORTAL_URL=https://registry.almena.id

# Social sign-in. Each provider stays off while its variables are empty.
REGISTRY_GOOGLE_CLIENT_ID=
REGISTRY_GOOGLE_CLIENT_SECRET=
REGISTRY_MICROSOFT_CLIENT_ID=
REGISTRY_MICROSOFT_CLIENT_SECRET=
# common (work, school and personal accounts), consumers, organizations or a tenant id.
REGISTRY_MICROSOFT_TENANT=common
REGISTRY_GITHUB_CLIENT_ID=
REGISTRY_GITHUB_CLIENT_SECRET=
# Apple: the Services ID, the team id, and the Sign in with Apple key (.p8)
# with its id; the key's PEM goes on one line with \n for the line breaks.
REGISTRY_APPLE_CLIENT_ID=
REGISTRY_APPLE_TEAM_ID=
REGISTRY_APPLE_KEY_ID=
REGISTRY_APPLE_PRIVATE_KEY=
